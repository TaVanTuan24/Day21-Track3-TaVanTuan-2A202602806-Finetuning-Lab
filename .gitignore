# Python
__pycache__/
*.py[cod]
.venv*/
.pytest_cache/
.ruff_cache/
# pytest writes its tmp_path tree to `pytest-of-<user>/` inside the repo when the system
# temp directory is not writable, which leaves `git status` dirty right after `make verify`.
pytest-of-*/
# uv's package cache, when UV_CACHE_DIR is pointed at the checkout
.uvcache/

# Jupyter
.ipynb_checkpoints/
# notebooks/*.py (jupytext) is the source of truth and IS committed.
# colab/*.ipynb is generated and IS committed (students launch from it).

# Lab artifacts — regenerated by the notebooks, never committed
adapters/*/
!adapters/.gitkeep
data/split/
data/CUSTOM_DATASET.md
results/*.json
results/*.csv
!results/.gitkeep
gguf/
*.gguf
runs/
wandb/

# Model / HF cache
.cache/
hf_cache/

# Secrets
.env
.env.local
*.token

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
