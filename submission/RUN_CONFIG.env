# Committed-evidence run configuration — Lab 21 (Track 3)
#
# Machine-readable record of the configuration that produced the artifacts in results/.
# NOT a secret: it holds no token, key or password, and is safe to commit.
#
# Why this file exists: the committed results/ were produced with COMPUTE_TIER=LAPTOP and
# BASE_MODEL=Qwen/Qwen3.5-0.8B, but colab/Lab21_RUN_ALL.ipynb defaults to COMPUTE_TIER=T4
# (the lab's documented path, and the right default for a free-Colab T4). A clean default
# "Run all" therefore reproduces the lab's T4 baseline, NOT these artifacts. This file
# pins the difference so the committed evidence is reproducible instead of described.
#
# To reproduce the committed artifacts:
#     set -a; . submission/RUN_CONFIG.env; set +a
#     python scripts/colab_run.py nb1 nb2 nb3 nb4 nb5      # nb6 optional (bonus B1)
# Verify with:  python scripts/verify.py     -> must print "Ready to submit."
#
# To run the lab's documented T4 path instead, just leave COMPUTE_TIER at T4 and unset
# BASE_MODEL — that is what the Colab notebook does by default.

# Tier: keeps batch 1 x grad_accum 8 and max_length 1024. NOT "T4": the training machine
# is a laptop GPU with 4 GB VRAM, and the T4 tier's model does not fit (see REPORT.md §1).
COMPUTE_TIER=LAPTOP

# Base model override. README allows this while keeping the tier's hardware settings.
# Qwen3.5-0.8B is the model the lab's own CPU tier ships (1.65 GB of weights), so the
# chat template and the NB1 think-block check are the shipped Qwen3.5 ones.
# scripts/check_mask_agreement.py was re-run for this override (REPORT.md §1).
BASE_MODEL=Qwen/Qwen3.5-0.8B

# The loss mask NB1 proved by decoding it back to text.
MASK_MODE=assistant-only

# One epoch budget shared by NB3 and NB4, so all four runs land on the same step count.
EPOCHS=2

# Deliberately NOT set. A submitted run must score the FULL eval set (50 target items,
# 15 regression items); uncommenting this makes results/baselines_frozen.json record
# smoke_mode=true and scripts/verify.py FAIL "full eval set used".
# EVAL_LIMIT=8

# No HF_TOKEN here, by design. A submitted run must leave it unset (or set it outside
# version control) — see .env.example and .gitignore.
